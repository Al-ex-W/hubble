# Hubble server configuration.
#
# Copy to .env and fill in. .env is gitignored — keys must never be committed.
# The browser never sees them. Nothing here is required to boot: without the
# LLM key the server still serves /table, the operator page and the keyboard
# act, and /api/render answers 503.

# Optional: ElevenLabs voice for the puppet master: Hubble TALKS,
# the person types (no speech input since 7 Oct 2026). Nothing requires it to boot: without
# it the puppet master answers in text only. The key needs only Text to Speech
# (+ Voices read) permissions; it does not need Speech to Text.
ELEVENLABS_API_KEY=
# Optional existing Hubble agent: puppet master reads its configured TTS voice.
# It does not change the hosted agent or use its LLM for canvas conversations.
ELEVENLABS_AGENT_ID=
# The DEFAULT puppet master voice (Roger). The Studio and /hubble pages let the viewer pick
# another from the premade list in apps/server/voices.ts; a voice set here that is not on
# that list is added to it as 'Custom'. A viewer's pick beats ELEVENLABS_AGENT_ID's voice.
ELEVENLABS_TTS_VOICE_ID=CwhRBWXzGAHq8TQ4Fs17
# Puppet master speech model. Default eleven_flash_v2_5: ~75 ms, multilingual.
# The demo speaks English; eleven_flash_v2 is English only. Only the hosted agent's
# voice is reused, never its model.
# ELEVENLABS_TTS_MODEL=eleven_flash_v2_5

# Aiqu (OpenAI-compatible): the model the brain calls for every table answer,
# and the puppet master's brain and Studio generation (HUBBLE_LLM_MODEL is the
# one default for all of them).
# Models: aixia-labs (DeepSeek 4.1), aixia-code (Kimi 2.6).
HUBBLE_LLM_BASE_URL=https://llm.aiqu.ai/v1
HUBBLE_LLM_API_KEY=sk-replace-me
HUBBLE_LLM_MODEL=aixia-labs
# Any OpenAI-compatible endpoint works for the puppet master, e.g.
#   HUBBLE_LLM_BASE_URL=https://api.openai.com/v1  HUBBLE_LLM_MODEL=gpt-4.1-mini
# 'off'|'on' sends chat_template_kwargs.thinking (a vLLM/DeepSeek template
# field). Unset: off for the Aiqu URL above, not sent at all for any other
# provider (OpenAI would reject the unknown field).
# HUBBLE_LLM_THINKING=off
# Model for the puppet master only; table rendering keeps HUBBLE_LLM_MODEL.
# HUBBLE_PUPPET_MODEL=

# Optional: TypeSafe Jev, a placement judge in the brain's verify step. When
# set, a draft that passes our own layout check (on a table with objects and
# panels) is also scored by api.typesafe.ai, 2.5 s deadline per call. A low
# score forces a repair, and each repair is verified (and scored) again, so one
# answer can cost several calls. Needs internet from wherever the server runs.
# Leave empty to turn it off.
TYPESAFE_API_KEY=

# Optional: what a web surface may open. Unset = any public website (`*`);
# local and private addresses (the room's devices, our own API) are always
# refused. Or comma-separated hostnames, exact match, to lock the room down.
# Optional: the table agent (apps/server/tableAgent.ts). On unless set to 'off'.
# HUBBLE_TABLE_AGENT=on

# Optional: hostnames a web surface may open, comma-separated, exact match.
# Replaces (does not extend) the default list in apps/server/config.ts.
HUBBLE_WEB_ALLOW=

PORT=8787
# Where Vite (:5173) proxies /api to. Only change it for an isolated preview stack.
# HUBBLE_API_URL=http://localhost:8787

# The iPad worksheet server (apps/worksheet, #60): started from the show
# column's checkbox, never at boot. It listens on loopback only; the iPad
# opens http://<laptop LAN IP>:5173/worksheet/ (a read-only Vite proxy).
WORKSHEET_PORT=8793

# --- The room (read in apps/server/index.ts, not config.ts yet) ---
# These are read with `??`, so an empty value is NOT the default: an empty
# ROOM_URL= would be an empty URL. Leave a line commented out to get its default.
# ROOM picks the hardware: none (default: bench and /table only), emulator
# (start `npm run dev:emulator` too), live (room.local on site), legacy (the
# room's NUC API).
ROOM=none
# Overrides the room's base URL (defaults: emulator http://127.0.0.1:8790,
# live http://room.local, legacy https://room.local:8443).
# ROOM_URL=
# ROOM_TOKEN=
# Our team id for slot-gated writes (defaults to `hubble` for the emulator only).
# ROOM_TEAM=
# Where room displays load our pages from (default http://<this laptop's LAN IP>:5173).
# PUBLIC_BASE=
# The keybed sidecar (apps/keybed, started by `npm run dev`).
# KEYBED_URL=http://127.0.0.1:8792

# ROOM=live only: each Pi and the Hue bridge directly (#58). Unset = the room
# package's own defaults from room.config.json.
# ROOM_PI_TABLE=
# ROOM_PI_TV1=
# ROOM_PI_TV2=
# ROOM_PI_LIDAR=
# ROOM_HUE=
# The Hue bridge API user is a credential: it lives here only.
# ROOM_HUE_USER=
# Lidar pose on the table, mm and degrees: x,y,rotation.
# ROOM_LIDAR_POSE=775,0,90

# Room sensors, read by the server. Empty = off. Pointing these at a real device
# talks to shared hardware.
# HUBBLE_ROOM_CAMERA_URL=
# LIDAR_URL=
# Solve camera → table once at boot ('on'), waiting this long for the dots to settle.
# HUBBLE_CALIBRATE_ON_BOOT=off
# HUBBLE_CALIBRATE_SETTLE_MS=1500
# HUBBLE_SPATIAL_REGISTRATION_FILE=.hubble/spatial-registration.json

# --- Scripts ---
# The mic-wave demo (scripts/mic-wave-demo.mjs): listener and TV renderer.
# MIC_LISTENER_PORT=8795
# MIC_RENDERER_PORT=8796
# The Studio browser smoke (scripts/studio-browser-smoke.mjs).
# STUDIO_URL=http://localhost:5173
