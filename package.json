{
  "name": "hubble",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A smart-lamp projector: ask a question about your notebook or play a real keyboard, and the answer is projected onto the table in front of you.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n server,web,keybed -c cyan,magenta,yellow \"npm:dev:server\" \"npm:dev:web\" \"npm:dev:keybed\"",
    "demo": "tsx scripts/demo.ts",
    "dev:server": "tsx watch apps/server/index.ts",
    "dev:studio": "concurrently -n studio,web -c cyan,magenta \"tsx watch apps/server/studioServer.ts\" \"vite apps/web --mode studio\"",
    "build:studio": "vite build apps/web --mode studio",
    "dev:web": "vite apps/web",
    "dev:keybed": "python3 apps/keybed/service.py",
    "build": "tsc -b && vite build apps/web",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "demo:smoke": "vitest run apps/server/demo.smoke.test.ts",
    "os:smoke": "vitest run apps/server/os.smoke.test.ts",
    "start": "tsx apps/server/index.ts",
    "hands:assets": "node scripts/hands-assets.mjs",
    "record:stage": "tsx packages/stage/scripts/record-stage-stream.ts",
    "calibration:standard": "tsx scripts/standard-calibration.ts",
    "hubble": "tsx scripts/hubble-cli/index.ts",
    "census:stage": "tsx packages/stage/scripts/stage-census.ts",
    "dev:emulator": "tsx watch apps/room-emulator/index.ts",
    "room:check": "tsx scripts/room-config.ts",
    "room:record": "tsx packages/room/scripts/room-record.ts",
    "room:apply": "tsx scripts/room-config.ts --apply",
    "lidar:check": "tsx packages/room/scripts/lidar-check.ts",
    "lidar:record": "tsx packages/room/scripts/lidar-record.ts",
    "spatial:record": "tsx scripts/spatial-record.ts",
    "lidar:session": "tsx scripts/lidar-session.ts",
    "lidar:live": "tsx scripts/lidar-live.ts"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "happy-dom": "^20.14.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8",
    "ws": "^8.18.0"
  }
}
